generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  STORE_OWNER
  MANAGER
  CASHIER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum TransactionType {
  CASH_IN
  CASH_OUT
  PAYMENT
  REFUND
}

enum AdjustmentType {
  ADD
  SUBTRACT
}

enum MfsAccountType {
  AGENT
  MERCHANT
  PERSONAL
}

enum MfsCategoryType {
  CASH_IN
  CASH_OUT
  PAY_BILL
  B2B_SEND
  B2B_RECEIVED
}

enum CommissionType {
  FLAT_PER_THOUSAND
  PERCENTAGE
}

enum MfsTxType {
  BUY_EMONEY
  SELL_EMONEY
  COMMISSION_GAIN
}

enum CapitalType {
  CAPITAL_IN    // মালিকের মূলধন বিনিয়োগ (+)
  DRAWING_OUT   // মালিকের ব্যক্তিগত উত্তোলন (-)
  LOAN_TAKEN    // বাইরে থেকে ঋণ গ্রহণ (+)
  LOAN_REPAID   // ঋণ পরিশোধ (-)
}

// ------------------------------------------------------
// STORE MODEL
// ------------------------------------------------------

model Store {
  id                    String                 @id
  name                  String
  address               String?
  phone                 String?
  currency              String                 @default("BDT")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  users                 User[]
  cashRegisters        CashRegister[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  supplierPayments      SupplierPayment[]
  categories            Category[]
  products              Product[]
  stockAdjustments      StockAdjustment[]
  customers             Customer[]
  customerPayments      CustomerPayment[]
  saleOrders            SaleOrder[]
  expenses              Expense[]
  expenseCategories     ExpenseCategory[]
  mfsAgentWallets       MFSAgentWallet[]
  mfsPersonalWallets    MFSPersonalWallet[]
  mfsCategories         MfsCategory[]
  mfsTransactions       MfsTransaction[]
  mfsOrders             MfsOrder[]
  dailyClosings         DailyClosing[]
  mfsDailyStocks        MfsDailyStock[]
  
  // 🎯 Capital & Investment Relation Added
  capitalTransactions   CapitalTransaction[]

  // Recharge Module Relations
  rechargeSims          RechargeSim[]
  rechargePurchases     RechargePurchase[]
  rechargeDailyBalances RechargeDailyBalance[]
}

model User {
  id            String         @id @default(uuid())
  staffCode     String?
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  email         String         @unique
  password      String
  role          Role           @default(CASHIER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  cashRegisters CashRegister[]
}

// ------------------------------------------------------
// CASH REGISTER & TRANSACTIONS
// ------------------------------------------------------

model CashRegister {
  id              String            @id @default(uuid())
  storeId         String
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation(fields: [userId], references: [id])

  openingBalance Float
  closingBalance Float?
  expectedBalance Float?
  difference     Float?

  status          ShiftStatus       @default(OPEN)
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  note            String?

  transactions    CashTransaction[]
  capitalTransactions CapitalTransaction[]
}

model CashTransaction {
  id         String          @id @default(uuid())
  registerId String
  register   CashRegister    @relation(fields: [registerId], references: [id], onDelete: Cascade)

  type       TransactionType
  amount     Float
  reason     String?
  createdAt  DateTime        @default(now())
}

// ------------------------------------------------------
// INVESTMENT & OWNER CAPITAL MANAGEMENT (ADDED MODEL)
// ------------------------------------------------------

model CapitalTransaction {
  id              String        @id @default(uuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  registerId      String?
  register        CashRegister? @relation(fields: [registerId], references: [id], onDelete: SetNull)

  type            CapitalType
  amount          Float
  sourceOrPerson  String?       // e.g. "Store Owner", "Bank Loan", "Friend"
  paymentMethod   String        @default("CASH")
  note            String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ------------------------------------------------------
// SUPPLIER & PURCHASES
// ------------------------------------------------------

model Supplier {
  id             String            @id @default(uuid())
  storeId        String
  store          Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name           String
  contactPerson  String?
  email          String?
  phone          String
  address        String?

  openingBalance Float             @default(0)
  currentBalance Float             @default(0)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]
}

model Category {
  id        String    @id @default(uuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name      String
  slug      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]
}

model Product {
  id                   String                @id @default(uuid())
  storeId              String
  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId           String?
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name                 String
  sku                  String?
  barcode              String?

  costPrice            Float                 @default(0)
  sellingPrice          Float                 @default(0)

  stock                Int                   @default(0)
  minStockAlert        Int                   @default(5)

  unit                 String                @default("PCS")
  description          String?

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  purchaseItems        PurchaseItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  saleItems            SaleItem[]
}

model PurchaseOrder {
  id          String         @id @default(uuid())
  storeId     String
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  invoiceNo   String
  totalAmount Float
  paidAmount  Float          @default(0)
  dueAmount   Float          @default(0)

  status      String         @default("RECEIVED")
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items       PurchaseItem[]
}

model PurchaseItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId       String
  product         Product       @relation(fields: [productId], references: [id])

  quantity        Int
  unitPrice       Float
  totalPrice      Float

  createdAt       DateTime      @default(now())
}

model SupplierPayment {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  amount        Float
  paymentMethod String   @default("CASH")
  referenceNo   String?
  note          String?

  createdAt     DateTime @default(now())
}

// ------------------------------------------------------
// STOCK ADJUSTMENTS
// ------------------------------------------------------

model StockAdjustment {
  id        String                @id @default(uuid())
  storeId   String
  store     Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)

  reason    String
  createdAt DateTime              @default(now())

  items     StockAdjustmentItem[]
}

model StockAdjustmentItem {
  id           String          @id @default(uuid())
  adjustmentId String
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  productId    String
  product      Product         @relation(fields: [productId], references: [id])

  type         AdjustmentType
  quantity     Int

  createdAt    DateTime        @default(now())
}

// ------------------------------------------------------
// CUSTOMERS & SALES
// ------------------------------------------------------

model Customer {
  id         String            @id @default(uuid())
  storeId    String
  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name       String
  phone      String
  email      String?
  address    String?

  dueBalance Float             @default(0)

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  payments   CustomerPayment[]
  saleOrders SaleOrder[]
}

model CustomerPayment {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  amount        Float
  paymentMethod String   @default("CASH")
  referenceNo   String?
  note          String?

  createdAt     DateTime @default(now())
}

model SaleOrder {
  id            String     @id @default(uuid())
  storeId       String
  store         Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  invoiceNo     String     @unique
  subTotal      Float
  discount      Float      @default(0)
  grandTotal    Float
  profitAmount  Float      @default(0)

  paidAmount    Float      @default(0)
  dueAmount     Float      @default(0)
  changeAmount  Float      @default(0)

  paymentMethod String     @default("CASH")
  status        String     @default("COMPLETED")

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  items         SaleItem[]
}

model SaleItem {
  id          String    @id @default(uuid())
  saleOrderId String
  saleOrder   SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)

  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  quantity    Int
  unitPrice   Float
  costPrice   Float     @default(0)
  totalPrice  Float

  createdAt   DateTime  @default(now())
}

// ------------------------------------------------------
// EXPENSES
// ------------------------------------------------------

model ExpenseCategory {
  id        String    @id @default(uuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name      String
  expenses  Expense[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Expense {
  id            String           @id @default(uuid())
  storeId       String
  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  amount        Float
  paymentMethod String           @default("CASH")
  title         String
  referenceNo   String?
  note          String?

  createdAt     DateTime         @default(now())
}

// ------------------------------------------------------
// MFS AGENT WALLETS, PERSONAL WALLETS & TRANSACTIONS
// ------------------------------------------------------

model MFSAgentWallet {
  id                String          @id @default(uuid())
  storeId           String
  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  providerName      String
  accountNumber     String
  accountType       MfsAccountType  @default(AGENT)

  openingBalance    Float           @default(0)
  currentBalance    Float           @default(0)

  commissionType    CommissionType  @default(FLAT_PER_THOUSAND)
  cashInCommission  Float           @default(4.12)
  cashOutCommission Float           @default(4.12)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  mfsOrders         MfsOrder[]
  dailyStocks       MfsDailyStock[]
}

model MFSPersonalWallet {
  id                String            @id @default(uuid())
  storeId           String
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  providerName      String
  accountNumber     String
  accountType       MfsAccountType    @default(PERSONAL)

  openingBalance    Float             @default(0)
  currentBalance    Float             @default(0)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  transactions      MfsTransaction[]
  dailyStocks       MfsDailyStock[]
}

model MfsCategory {
  id          String          @id @default(uuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name        String
  type        MfsCategoryType
  description String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model MfsTransaction {
  id                String            @id @default(uuid())
  storeId           String
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  personalWalletId  String
  personalWallet    MFSPersonalWallet @relation(fields: [personalWalletId], references: [id], onDelete: Cascade)

  type              MfsTxType
  
  cashAmount        Float
  walletAmount      Float
  profitAmount      Float             @default(0)

  referenceNo       String?
  note              String?

  createdAt         DateTime          @default(now())
}

model MfsOrder {
  id                String          @id @default(uuid())
  storeId           String
  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  agentWalletId     String
  agentWallet       MFSAgentWallet  @relation(fields: [agentWalletId], references: [id], onDelete: Cascade)

  transactionType   MfsCategoryType
  
  customerPhone     String?
  amount            Float
  commissionAmount  Float           @default(0)
  netCashImpact     Float
  netWalletImpact   Float

  referenceTrxId    String?
  note              String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// ------------------------------------------------------
// DAILY CLOSING & UNIFIED MFS STOCK
// ------------------------------------------------------

model DailyClosing {
  id                    String   @id @default(uuid())
  storeId               String
  store                 Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  closingDate           DateTime @default(now())

  totalShopSales        Float    @default(0)
  shopCostOfGoods       Float    @default(0)
  shopGrossProfit       Float    @default(0)
  totalExpenses         Float    @default(0)

  openingCash           Float    @default(0)
  closingCash           Float    @default(0)
  systemCalculatedCash Float    @default(0)

  agentWalletBalance    Float    @default(0)
  agentCommissionEarned Float    @default(0)

  personalWalletBalance Float    @default(0)
  personalExtraEarned   Float    @default(0)

  totalStartingAssets   Float    @default(0)
  totalEndingAssets     Float    @default(0)
  discrepancyAmount     Float    @default(0)
  netDayProfit          Float    @default(0)

  note                  String?
  createdAt             DateTime @default(now())
}

model MfsDailyStock {
  id                String             @id @default(uuid())
  storeId           String
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  walletCategory    String             @default("AGENT") // "AGENT" | "PERSONAL"

  agentWalletId     String?
  agentWallet       MFSAgentWallet?    @relation(fields: [agentWalletId], references: [id], onDelete: Cascade)

  personalWalletId  String?
  personalWallet    MFSPersonalWallet? @relation(fields: [personalWalletId], references: [id], onDelete: Cascade)

  entryDate         DateTime           @default(now())

  totalIn           Float              @default(0)
  totalOut          Float              @default(0)
  totalProfit       Float              @default(0)
  endingBalance     Float              @default(0)

  note              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// ------------------------------------------------------
// FLEXILOAD & RECHARGE MODULE MODELS
// ------------------------------------------------------

model RechargeSim {
  id             String                 @id @default(uuid())
  storeId        String
  store          Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  operatorName   String                 // Grameenphone, Robi, Banglalink, Airtel, Teletalk
  simNumber      String                 // 017XXXXXXXX
  currentBalance Float                  @default(0) // বর্তমান লাইভ সিম ব্যালেন্স

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  purchases      RechargePurchase[]
  dailyBalances  RechargeDailyBalance[]
}

model RechargePurchase {
  id             String      @id @default(uuid())
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  simId          String
  sim            RechargeSim @relation(fields: [simId], references: [id], onDelete: Cascade)

  amount         Float       // কেনা রিচার্জ টাকা (e.g. 5000 BDT)
  commission     Float       @default(0) // অর্জিত কমিশন (e.g. 135 BDT)
  totalReceived  Float       // সিমে যোগ হওয়া মোট ব্যালেন্স (Amount + Commission)

  note           String?
  createdAt      DateTime    @default(now())
}

model RechargeDailyBalance {
  id             String      @id @default(uuid())
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  simId          String
  sim            RechargeSim @relation(fields: [simId], references: [id], onDelete: Cascade)

  entryDate      DateTime    @default(now()) // হিসাবের তারিখ
  endingBalance  Float       @default(0)     // দিনশেষে সিমে অবশিষ্ট ব্যালেন্স
  calculatedSell Float       @default(0)     // সারাদিনের অটো রিচার্জ বিক্রি

  note           String?
  createdAt      DateTime    @default(now())
}